@inherits GameComponent

@{
    var s = Game.State!;
    int px = s.Char.X, py = s.Char.Y;
    int sight = Game.SightRadius;
}
<div class="map-wrap">
    <svg class="map" viewBox="0 0 @(W * T) @(H * T)" role="img" aria-label="Karte">
        <defs>
            <pattern id="fog" width="8" height="8" patternUnits="userSpaceOnUse">
                <rect width="8" height="8" fill="#0a0a0c" />
                <path d="M0 8L8 0" stroke="#141418" stroke-width="1" />
            </pattern>
            <radialGradient id="vignette" cx=".5" cy=".5" r=".75">
                <stop offset=".55" stop-color="#000" stop-opacity="0" />
                <stop offset="1" stop-color="#000" stop-opacity=".65" />
            </radialGradient>
        </defs>
        @for (int vy = 0; vy < H; vy++)
        {
            for (int vx = 0; vx < W; vx++)
            {
                int wx = px + vx - W / 2, wy = py + vy - H / 2;
                int sx = vx * T, sy = vy * T;
                var state = s.TileState(wx, wy);
                if (!state.HasFlag(TileFlags.Explored))
                {
                    <rect x="@sx" y="@sy" width="@T" height="@T" fill="url(#fog)" />
                    continue;
                }
                var t = Game.World!.Tile(wx, wy);
                int dx = wx - px, dy = wy - py;
                bool visible = dx * dx + dy * dy <= sight * sight + sight;
                bool adjacent = Math.Abs(dx) + Math.Abs(dy) == 1;
                <g class="tile @(adjacent && t.Biome.Passable ? "adj" : "") @(t.Biome.Passable ? "" : "blocked")"
                   transform="translate(@sx @sy)" @onclick="() => Click(wx, wy)">
                    <rect width="@T" height="@T" fill="@t.Biome.Color" />
                    @if (!string.IsNullOrEmpty(t.Biome.Glyph))
                    {
                        <g opacity=".9">@((MarkupString)t.Biome.Glyph)</g>
                    }
                    <rect class="tile-grid" width="@T" height="@T" />
                    @if (t.Dungeon is not null)
                    {
                        <g class="poi dungeon-entry" style="--dc:@t.Dungeon.Color">
                            <rect x="10" y="10" width="28" height="28" rx="5" />
                            <text x="24" y="24">@t.Dungeon.Marker</text>
                        </g>
                    }
                    else if (t.Poi is not null && !state.HasFlag(TileFlags.Resolved))
                    {
                        <g class="poi">
                            <circle cx="24" cy="24" r="13" />
                            <text x="24" y="24">@t.Poi.Marker</text>
                        </g>
                    }
                    @if (!visible)
                    {
                        <rect width="@T" height="@T" fill="#000" opacity=".45" pointer-events="none" />
                    }
                </g>
            }
        }
        <rect width="@(W * T)" height="@(H * T)" fill="url(#vignette)" pointer-events="none" />
        <g class="player" transform="translate(@((W / 2) * T + T / 2) @((H / 2) * T + T / 2))" pointer-events="none">
            <circle class="player-pulse" r="18" />
            <circle r="10" fill="#f2b43a" stroke="#1a1208" stroke-width="3" />
            <circle r="3.5" fill="#1a1208" />
        </g>
    </svg>
    <div class="compass">N</div>
</div>

@code {
    private const int T = 48;
    [Parameter] public int Cols { get; set; } = 19;
    [Parameter] public int Rows { get; set; } = 11;
    private int W => Cols;
    private int H => Rows;
    private void Click(int x, int y) => Game.StepToward(x, y);
}
