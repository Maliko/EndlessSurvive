@inherits GameComponent

@{
    var ev = Game.Event!;
}
<div class="overlay">
    <div class="dialog event-dialog">
        <div class="event-head" style="--biome:@ev.Tile.Biome.Color">
            <span class="event-marker">@(ev.Def.Key == "_dungeon" ? "◆" : ev.Def.Marker)</span>
            <div>
                <h2>@ev.Def.Title</h2>
                <small>@(Game.State!.InDungeon ? $"{Game.CurrentDungeon?.Name} · {Game.CurrentFloor?.Name}" : ev.Tile.Biome.Name) · Gefahrenstufe @ev.Tile.Danger</small>
            </div>
        </div>
        <p class="event-text">@ev.Def.Text</p>

        @if (ev.ResultText is null)
        {
            <ol class="options">
                @for (int i = 0; i < ev.Options.Count; i++)
                {
                    var o = ev.Options[i];
                    <li>
                        <button class="option" disabled="@(!o.Available)" @onclick="() => Game.ChooseOption(o)">
                            <kbd>@(i + 1)</kbd>
                            <span class="option-label">@o.Def.Label</span>
                            @if (o.Chance is not null)
                            {
                                <span class="option-check">
                                    <span>@o.SkillName</span>
                                    <strong class="@ChanceClass(o.Chance.Value)">@o.Chance%</strong>
                                </span>
                            }
                            @if (o.Hint is not null)
                            {
                                <span class="option-hint">@o.Hint</span>
                            }
                        </button>
                    </li>
                }
            </ol>
            @if (Game.CanLeaveEvent && ev.IsPoi)
            {
                <div class="dialog-actions">
                    <button class="btn btn-ghost" @onclick="Game.LeaveEvent">Spaeter <kbd>Esc</kbd></button>
                </div>
            }
        }
        else
        {
            @if (ev.Roll is { } r)
            {
                <DiceRoll Roll="r" />
            }
            <p class="result-text">@ev.ResultText</p>
            @if (ev.ResultLines.Count > 0)
            {
                <ul class="result-lines">
                    @foreach (var l in ev.ResultLines)
                    {
                        <li class="@LineClass(l)">@l</li>
                    }
                </ul>
            }
            @if (ev.Finished)
            {
                <div class="dialog-actions">
                    <button class="btn btn-primary" @onclick="Game.CloseEvent">Weiter <kbd>Enter</kbd></button>
                </div>
            }
        }
    </div>
</div>

@code {
    private static string ChanceClass(int c) => c >= 70 ? "good" : c >= 40 ? "mid" : "bad";
    private static string LineClass(string l) => l.StartsWith('−') ? "bad" : l.StartsWith('+') ? "good" : l.StartsWith("Gefunden") || l.StartsWith("Erhalten") ? "loot" : "";
}
