<div class="bar bar-@Kind" title="@Label @Value / @Max">
    <span class="bar-label">@Label</span>
    <div class="bar-track"><div class="bar-fill" style="width:@Pct%"></div></div>
    <span class="bar-value">@Value / @Max</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public long Value { get; set; }
    [Parameter] public long Max { get; set; } = 1;
    [Parameter] public string Kind { get; set; } = "hp";
    private string Pct => (Max <= 0 ? 0 : Math.Clamp(Value * 100.0 / Max, 0, 100)).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}
