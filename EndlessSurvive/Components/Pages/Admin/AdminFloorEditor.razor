    {
        if (long.TryParse(e.Value?.ToString(), out var fid) && fid != Id) Nav.NavigateTo($"/admin/ruins/{Key}/floor/{fid}");
    }

    // ================= Stockwerk =================

    private void SaveFloorSettings()
    {
        Admin.Update(_floorTable!, Id, new Dictionary<string, object?>
        {
            ["Name"] = string.IsNullOrWhiteSpace(_floorName) ? "Ebene" : _floorName.Trim(),
            ["SortOrder"] = (long)_floorSort, ["DangerOffset"] = (long)Math.Max(0, _floorDanger),
        });
        Flash("Stockwerk gespeichert.");
    }

    private void Resize()
    {
        int w = Math.Clamp(_newW, 3, 120), h = Math.Clamp(_newH, 3, 120);
        var outside = Floor!.Objects.Where(o => o.X >= w || o.Y >= h).ToList();
        if (outside.Count > 0)
        {
            Flash($"Erst diese Objekte verschieben oder löschen, sie lägen außerhalb: {string.Join(", ", outside.Select(o => $"{ObjTitle(o)} ({o.X},{o.Y})"))}", bad: true);
            return;
        }
        PushUndo();
        var g = new string[h][];
        for (int y = 0; y < h; y++)
        {
            g[y] = new string[w];
            for (int x = 0; x < w; x++) g[y][x] = y < _h && x < _w ? _grid[y][x] : "void";
        }
        _undo.Clear(); // Groessenwechsel ist nicht rueckgaengig zu machen
        Admin.Update(_floorTable!, Id, new Dictionary<string, object?>
        {
            ["Width"] = (long)w, ["Height"] = (long)h, ["Tiles"] = DungeonFloorDef.SerializeGrid(g),
        });
        _grid = g; _w = w; _h = h; _dirty = false;
        Flash($"Größe auf {w} × {h} geändert und gespeichert.");
    }

    // ================= Objekte =================

    private void Select(long id)
    {
        var o = ObjectById(id);
        if (o is null) return;
        if (o.FloorId != Id) { Nav.NavigateTo($"/admin/ruins/{Key}/floor/{o.FloorId}?select={id}"); return; }
        _selected = id;
        _objErrors.Clear();
        var row = Admin.Row(_objTable!, id);
        _objForm = _objTable!.Columns.ToDictionary(c => c.Name, c => (string?)row?.Text(c.Name));
    }

    private static string[] KindColumns(string kind) => kind switch
    {
        "entrance" => ["Label"],
        "exit" => ["Label", "Description", "Icon"],
        "transition" => ["Label", "Description", "Icon", "TargetFloorId", "TargetX", "TargetY"],
        "container" or "door" => ["Label", "Description", "Icon", "SkillKey", "Difficulty", "Effects", "FailEffects"],
        "enemy" => ["EnemyKey", "Label", "Description", "Effects"],
        "event" => ["EventKey", "Icon"],
        "trigger" => ["Label", "Description", "Icon", "Effects"],
        _ => ["Label", "Description", "Icon", "Effects"],
    };

    private static string KindHelp(string kind) => kind switch
    {
        "entrance" => "Hier startet man beim Betreten der Ruine. Pro Ruine reicht einer (auf dem ersten Stockwerk).",
        "exit" => "Betreten öffnet die Frage „Ruine verlassen?“.",
        "transition" => "Treppe, Leiter, Schacht: Betreten bringt dich zum Zielfeld – auch auf ein anderes Stockwerk.",
        "container" => "Kiste, Schrank, Spind. Wird durch Anlaufen geöffnet. Inhalt = Effekte (z. B. item:medkit:1;loot:2). Mit Probe: verschlossen.",
        "door" => "Versperrt den Weg, bis sie geöffnet ist. Mit Probe: abgeschlossen. Danach verschwindet das Symbol.",
        "enemy" => "Versperrt den Weg. Anlaufen startet den Kampf. Effekte = Belohnung nach dem Sieg.",
        "event" => "Öffnet ein Ereignis aus der Tabelle Ereignisse (Art dungeon empfohlen).",
        "trigger" => "Unsichtbar (außer mit Symbol). Löst beim Betreten einmalig Effekte aus, z. B. story:KEY oder damage:2-5 als Falle.",
        _ => "",
    };

    private void PlaceObject(int x, int y)
    {
        if (Floor!.ObjectAt(x, y) is { } existing) { Select(existing.Id); return; }
        var icon = DungeonKinds.All.First(k => k.Key == _objKind).DefaultIcon;
        var values = new Dictionary<string, object?>
        {
            ["FloorId"] = Id, ["X"] = (long)x, ["Y"] = (long)y, ["Kind"] = _objKind, ["Icon"] = icon,
            ["Label"] = _objKind switch { "container" => "Kiste", "door" => "Tür", "exit" => "Ausgang", "transition" => "Treppe", _ => null },
        };
        if (_objKind == "enemy") values["EnemyKey"] = Content.Enemies.Values.OrderBy(e => e.MinDanger).ThenBy(e => e.Key).FirstOrDefault()?.Key;
        if (_objKind == "event") values["EventKey"] = Content.Events.Values.FirstOrDefault(e => e.Kind == "dungeon")?.Key ?? Content.Events.Keys.FirstOrDefault();
        var id = Admin.Insert(_objTable!, values);
        Select(id);
        Flash($"{DungeonKinds.Name(_objKind)} gesetzt. Eigenschaften rechts bearbeiten.");
    }

    private void SaveObject()
    {
        var o = ObjectById(_selected);
        if (o is null) return;
        _objErrors.Clear();
        var values = new Dictionary<string, object?>();
        var kind = _objForm.GetValueOrDefault("Kind") ?? o.Kind;
        values["Kind"] = kind;
        foreach (var col in KindColumns(kind))
        {
            var ci = _objTable!.Column(col)!;
            var v = ContentAdmin.Convert(ci, _objForm.GetValueOrDefault(col), out var err);
            if (err is not null) _objErrors[col] = err;
            values[col] = v;
        }
        if (_objErrors.Count > 0) { Flash("Bitte die markierten Felder prüfen.", bad: true); return; }
        try
        {
            Admin.Update(_objTable!, o.Id, values);
            Select(o.Id);
            Flash("Objekt gespeichert.");
        }
        catch (Microsoft.Data.Sqlite.SqliteException ex) { Flash("Datenbankfehler: " + ex.Message, bad: true); }
    }

    private void DeleteObject()
    {
        if (ObjectById(_selected) is not { } o) return;
        Admin.Delete(_objTable!, o.Id, cascade: true);
        _selected = null;
        Flash($"{DungeonKinds.Name(o.Kind)} gelöscht.");
    }

    private void MoveObject(long id, int x, int y)
    {
        _moveObj = null;
        if (Floor!.ObjectAt(x, y) is { } other && other.Id != id) { Flash("Auf dem Feld liegt schon ein Objekt.", bad: true); return; }
        Admin.Update(_objTable!, id, new Dictionary<string, object?> { ["X"] = (long)x, ["Y"] = (long)y });
        Select(id);
        Flash("Objekt verschoben.");
    }

    private void AppendStory(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (string.IsNullOrEmpty(key)) return;
        _objForm["Effects"] = AppendEffect(_objForm.GetValueOrDefault("Effects"), $"story:{key}");
    }

    public static string AppendEffect(string? existing, string add)
    {
        var parts = (existing ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (!parts.Contains(add)) parts.Add(add);
        return string.Join(";", parts);
    }

    // ================= Uebergaenge =================

    private void PickTarget(DungeonObjectDef o)
    {
        var target = long.TryParse(_objForm.GetValueOrDefault("TargetFloorId"), out var tf) ? tf : o.TargetFloorId ?? Id;
        // Eingetragenes Ziel-Stockwerk vorher uebernehmen
        if (target != o.TargetFloorId) Admin.Update(_objTable!, o.Id, new Dictionary<string, object?> { ["TargetFloorId"] = target });
        SaveIfDirty();
        var tfKey = Content.Floors.GetValueOrDefault(target)?.DungeonKey ?? Key;
        Nav.NavigateTo($"/admin/ruins/{tfKey}/floor/{target}?pick={o.Id}");
    }

    private void SetTarget(long objId, int x, int y)
    {
        if (!Passable(x, y)) { Flash("Das Zielfeld muss begehbar sein.", bad: true); return; }
        var o = ObjectById(objId);
        if (o is null) { CancelModes(); return; }
        Admin.Update(_objTable!, objId, new Dictionary<string, object?> { ["TargetFloorId"] = Id, ["TargetX"] = (long)x, ["TargetY"] = (long)y });
        SaveIfDirty();
        var src = Content.Floors.GetValueOrDefault(o.FloorId);
        Nav.NavigateTo($"/admin/ruins/{src?.DungeonKey ?? Key}/floor/{o.FloorId}?select={objId}");
    }

    private void CreateReturn(DungeonObjectDef o)
    {
        if (o.TargetFloorId is not long tf || !Content.Floors.TryGetValue(tf, out var target) || o.TargetX is not int tx || o.TargetY is not int ty)
        {
            Flash("Erst ein Ziel festlegen.", bad: true);
            return;
        }
        if (target.ObjectAt(tx, ty) is { } existing)
        {
            Flash($"Auf dem Zielfeld liegt schon „{ObjTitle(existing)}“.", bad: true);
            return;
        }
        var icon = o.Icon switch { "obj_stairs_down" => "obj_stairs_up", "obj_stairs_up" => "obj_stairs_down", var i => i };
        var id = Admin.Insert(_objTable!, new Dictionary<string, object?>
        {
            ["FloorId"] = tf, ["X"] = (long)tx, ["Y"] = (long)ty, ["Kind"] = "transition", ["Icon"] = icon,
            ["Label"] = $"Zurück: {Floor!.Name}", ["TargetFloorId"] = Id, ["TargetX"] = (long)o.X, ["TargetY"] = (long)o.Y,
        });
        Flash($"Rückweg auf „{target.Name}“ ({tx},{ty}) angelegt.");
    }

    // ================= Storyboard-Verknuepfung =================

    private void PlaceEffect(string effect, int x, int y)
    {
        long id;
        if (Floor!.ObjectAt(x, y) is { } o)
        {
            Admin.Update(_objTable!, o.Id, new Dictionary<string, object?> { ["Effects"] = AppendEffect(o.Effects, effect) });
            id = o.Id;
        }
        else
        {
            if (!Passable(x, y)) { Flash("Auslöser brauchen ein begehbares Feld.", bad: true); return; }
            id = Admin.Insert(_objTable!, new Dictionary<string, object?>
            {
                ["FloorId"] = Id, ["X"] = (long)x, ["Y"] = (long)y, ["Kind"] = "trigger", ["Effects"] = effect,
            });
        }
        _placeEffect = null;
        Nav.NavigateTo($"/admin/ruins/{Key}/floor/{Id}?select={id}", replace: true);
        Flash($"{effect} verknüpft.");
    }

    // ================= Testen =================

    private void TestHere()
    {
        if (!Saves.Exists()) { Flash("Es gibt noch keinen Spielstand. Starte zuerst ein Spiel.", bad: true); return; }
        SaveIfDirty();
        (int x, int y)? start = _cell is var (cx, cy) && Passable(cx, cy) && Floor!.ObjectAt(cx, cy) is not { Blocks: true } ? (cx, cy) : null;
        start ??= Floor!.Objects.FirstOrDefault(o => o.Kind == "entrance") is { } ent ? (ent.X, ent.Y) : null;
        if (start is null)
            for (int y = 0; y < _h && start is null; y++)
                for (int x = 0; x < _w; x++)
                    if (Passable(x, y) && Floor!.ObjectAt(x, y) is null) { start = (x, y); break; }
        if (start is not var (sx, sy)) { Flash("Kein begehbares Feld auf diesem Stockwerk.", bad: true); return; }
        Saves.PlaceInDungeon(Key, Id, sx, sy);
        Saves.NotifyExternalChange();
        Flash($"Spielfigur steht jetzt auf {Floor!.Name} {sx},{sy}.", testLink: true);
    }
